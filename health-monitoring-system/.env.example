# SRE Monitoring Dashboard configurations

APP_NAME="Health Monitoring Dashboard"

# Database Connection (SQLite default, replace with postgres://user:pass@host:port/db in production)
DATABASE_URL="sqlite:///./health.db"

# JWT token signing secret key
SECRET_KEY="super-secret-key-development-only-change-this-in-production-123456"

# Token expiration delay in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=120
